# ── Python ──────────────────────────────────────────────────────────
.venv/
venv/
backend/.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
# Only app build outputs — never strip package trees under node_modules
/dist/
!/dist/DataForge/DataForge.exe
/build/
frontend/dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.cover

# ── Node / Vue ──────────────────────────────────────────────────────
# frontend/node_modules/ is tracked so clones can run without npm install
!frontend/node_modules/
!frontend/node_modules/**
npm-debug.log*
yarn-error.log*
.pnpm-store/

# ── Runtime data (local only) ───────────────────────────────────────
data/
*.sqlite
*.sqlite3
*.db

# ── Secrets & env ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── OS / editor ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ── Logs & temp ─────────────────────────────────────────────────────
*.log
tmp/
temp/
*.tmp

# ── Nested / accidental clones ──────────────────────────────────────
/DataForge/

# ── Docs: README + agent/Duo instruction files that must ship to GitLab ─
*.md
!README.md
!AGENTS.md
!.gitlab/**/*.md
!skills/**/*.md

# ── Local-only tooling (keep on disk; do not commit) ────────────────
.github/
.grok/
GOAL.md
SCORECARD.md
GOALS.md
*.session.md
CONTEXT.md
GROK_BUILD_SETUP.md

# PowerShell: ignore ad-hoc leftovers, keep packaging/start scripts
*.ps1
!scripts/build-exe.ps1
!scripts/start-desktop.ps1
scripts/cleanup-electron-remnants.ps1
scripts/finalize-dataforge-path.ps1
scripts/finalize-pv-path.ps1

# NOTE: .gitlab/ and AGENTS.md ARE intended for commit (GitLab Duo + CI).
# Do not add a blanket ".gitlab/" ignore rule.

# Desktop exe packaging
build/pyinstaller/
